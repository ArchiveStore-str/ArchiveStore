rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['raffzenn0968@gmail.com','archivestore321@gmail.com'];
    }
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /portfolios/{id} { allow read: if true; allow write: if isAdmin(); }
    match /orders/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id','productTitle','price','buyerName','contact','brief','paymentMethod','status','createdAt'])
                    && request.resource.data.status == 'Diproses';
    }
  }
}
